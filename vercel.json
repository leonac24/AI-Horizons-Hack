{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{core/**,server/**,data/config/**,data/processed/**,data/models/**,pipeline/__init__.py,pipeline/carbon_prototypes.py,pipeline/carbon_geography.py,pipeline/overflow_context.py,pipeline/zoning/rules_review.yaml,pipeline/zoning/review_priority.json}",
      "excludeFiles": "{web/**,data/raw/**,tests/**,.venv/**}"
    }
  }
}
