# LLM provider for runtime explanations and offline zoning extraction.
# gemini | none   (none = deterministic template explanations only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Runtime explanations (short, fast)
LLM_MODEL=gemini-3.8-flash
# Offline zoning extraction (long legal text, accuracy matters)
ZONING_EXTRACT_MODEL=gemini-2.5-pro
