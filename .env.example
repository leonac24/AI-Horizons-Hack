# LLM provider for runtime explanations and offline zoning extraction.
# anthropic | none   (none = deterministic template explanations only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Runtime explanations (effort, timeout and token cap live in data/config/app.yaml)
LLM_MODEL=claude-opus-5
# Offline zoning extraction (long legal text, accuracy matters)
ZONING_EXTRACT_MODEL=claude-opus-5
